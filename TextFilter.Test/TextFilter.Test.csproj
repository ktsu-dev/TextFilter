<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!--
      ktsu.Sdk defaults this to true, which resolves every culture to the invariant one and makes
      new CultureInfo("tr-TR") throw. That default belongs to the application being built, not to
      the applications that consume this library: a consumer outside the ktsu SDK runs with real
      culture data, and culture-sensitive matching is only observable there. The test host needs
      the culture data its callers have, or the tests that pin culture independence cannot run.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextFilter\TextFilter.csproj" />
  </ItemGroup>

</Project>
